# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# IDs Discord des administrateurs, separes par des virgules.
# Les administrateurs du serveur sont reconnus automatiquement.
ADMIN_IDS=123456789012345678,987654321098765432

# Dossier de stockage des donnees (points d'experience).
# Sur Railway, pointe-le vers un volume monte pour les conserver : /data
DATA_DIR=data

# Optionnel : si defini, un serveur HTTP de healthcheck ecoute sur ce port.
# Inutile pour un service worker Railway.
# PORT=8080
